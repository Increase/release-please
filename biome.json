{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "test/**/*.ts",
      "typings/**/*.d.ts",
      "*.js",
      "biome.json",
      "package.json",
      "tsconfig.json",
      ".vscode/*.json",
      "!!test/fixtures",
      "!!__snapshots__",
      "!!build",
      "!!dist",
      "!!docs"
    ]
  },
  "formatter": {
    "includes": [
      "biome.json",
      "package.json",
      "tsconfig.json",
      ".vscode/*.json"
    ],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": false,
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "recommended": true,
      "complexity": {
        "noBannedTypes": "off"
      },
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        }
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noExplicitAny": "off",
        "noExportsInTest": "off",
        "noImplicitAnyLet": "off",
        "noShadowRestrictedNames": "off",
        "noTemplateCurlyInString": "off",
        "noUnsafeDeclarationMerging": "off",
        "useIterableCallbackReturn": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
