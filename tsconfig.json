{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "node20",
    "noEmit": false,
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "pretty": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "target": "ES2023",
    "lib": ["ES2023"],
    "isolatedModules": true,
    "incremental": true,
    "rootDir": ".",
    "outDir": "build",
    "typeRoots": ["./typings", "./node_modules/@types"]
  },
  "include": ["typings/iarna__toml.d.ts", "src/**/*.ts"],
  "exclude": [
    "__snapshots__",
    "test",
    "system-test",
    "node_modules",
    "build",
    "dist"
  ]
}
