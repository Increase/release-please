        "changesBranch": "main",
        "component": undefined,
        "matchPattern": /\\^chore: release \\(\\?<branch>\\[\\\\w-\\./\\]\\+\\)\\?\\$/,
        "pullRequestTitlePattern": "chore: release \${branch}",
        "targetBranch": "main",
        "version": undefined,
      },
