version = "1.1.2"

[dependencies]
tracing = "1.0.0"",
          },
        },
        {
          "createIfMissing": false,
          "path": "packages/rustB/Cargo.toml",
          "updater": RawContent {
            "rawContent": "[package]
name = "pkgB"
version = "2.2.3"

[dependencies]
pkgA = { version = "1.1.2", path = "../pkgA" }
tracing = "1.0.0"",
          },
        },
        {
          "createIfMissing": false,
          "path": "packages/rustC/Cargo.toml",
          "updater": RawContent {
            "rawContent": "[package]
name = "pkgC"
version = "3.3.4"

[dependencies]
