          },
        },
        {
          "createIfMissing": false,
          "path": "packages/rustE/CHANGELOG.md",
          "updater": Changelog {
            "changelogEntry": "* The following workspace dependencies were updated
  * dependencies
    * pkgA bumped from 1.1.1 to 1.1.2",
