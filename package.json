{
  "name": "@increase/release-please",
  "version": "1.0.0",
  "private": true,
  "description": "Generate release PRs based on the conventionalcommits.org spec",
  "main": "./build/src/index.js",
  "types": "build/src/index.d.ts",
  "bin": {
    "release-please": "./build/src/bin/release-please.js"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "tsc",
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "fix": "biome check --write",
    "start": "node ./build/src/bin/release-please.js",
    "test": "ENVIRONMENT=test vitest run",
    "test:coverage": "ENVIRONMENT=test vitest run --coverage",
    "test:snapshot": "ENVIRONMENT=test vitest run -u",
    "build:action": "ncc build src/main.ts -o dist --source-map --license licenses.txt --target es2022 --no-cache && node -e \"require('fs').rmSync('dist/src',{recursive:true,force:true});require('fs').rmSync('dist/test',{recursive:true,force:true})\""
  },
  "files": [
    "build/src",
    "templates",
    "schemas",
    "build/schemas"
  ],
  "repository": "increase/release-please",
  "keywords": [
    "release",
    "conventional-commits"
  ],
  "author": "Increase",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/increase/release-please/issues"
  },
  "homepage": "https://github.com/increase/release-please#readme",
  "devDependencies": {
    "@actions/core": "^1.11.1",
    "@biomejs/biome": "^2.4.15",
    "@octokit/types": "^16.0.0",
    "@types/diff": "^5.0.2",
    "@types/jsonpath": "^0.2.0",
    "@types/lerna__package": "^5.1.0",
    "@types/lerna__package-graph": "^5.1.0",
    "@types/node": "^24.12.4",
    "@types/semver": "^7.7.1",
    "@types/xmldom": "^0.1.31",
    "@types/yargs": "^17.0.0",
    "@vercel/ncc": "^0.38.4",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "msw": "^2.10.2",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@conventional-commits/parser": "^0.4.1",
    "@google-automations/git-file-utils": "^3.0.1",
    "@iarna/toml": "^3.0.0",
    "@lerna/package": "^6.4.1",
    "@lerna/package-graph": "^6.4.1",
    "@octokit/core": "^7.0.6",
    "@octokit/graphql": "^9.0.3",
    "@octokit/plugin-retry": "8.1.0",
    "@octokit/plugin-throttling": "11.0.3",
    "@octokit/request": "^10.0.9",
    "@octokit/request-error": "^7.1.0",
    "@octokit/rest": "^22.0.1",
    "@types/npm-package-arg": "^6.1.0",
    "@xmldom/xmldom": "^0.9.10",
    "code-suggester": "^4.2.0",
    "conventional-changelog-conventionalcommits": "^6.0.0",
    "conventional-changelog-writer": "^6.0.0",
    "conventional-commits-filter": "^3.0.0",
    "detect-indent": "^6.1.0",
    "diff": "^5.2.2",
    "http-proxy-agent": "^9.0.0",
    "https-proxy-agent": "^7.0.6",
    "jsonpath": "^1.3.0",
    "node-html-parser": "^6.0.0",
    "semver": "^7.8.0",
    "type-fest": "^5.6.0",
    "typescript": "^5.9.3",
    "unist-util-visit": "^2.0.3",
    "unist-util-visit-parents": "^3.1.1",
    "xpath": "^0.0.34",
    "yaml": "^2.8.3",
    "yargs": "^17.0.0"
  }
}
